{
  "name": "forger-bench",
  "version": "0.1.0",
  "private": true,
  "description": "Efficiency-aware benchmark for generated app code on the InsForge SDK.",
  "type": "commonjs",
  "scripts": {
    "smoke": "node mock/smoke.js",
    "calibrate": "node bench/calibrate.js",
    "verify": "node bench/verify.js",
    "contamination": "node bench/contamination.js",
    "demo": "node bench/demo.js",
    "audit": "node live/audit.js",
    "judge-demo": "node ../demo_server.js 8900",
    "branch-review": "node ../tools/forger.js branch-review --scenario slow-query-index --record results/demo-recordings/branch-review-slow-query-index",
    "check": "node mock/smoke.js && node bench/calibrate.js && node bench/verify.js && node bench/contamination.js"
  },
  "license": "MIT",
  "dependencies": {
    "@insforge/sdk": "^1.3.1"
  }
}
