{
  "name": "insforge-hackathon-forger",
  "version": "0.2.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "judge-demo": "node demo_server.js 8900",
    "branch-review": "node tools/forger.js branch-review --scenario slow-query-index --record bench/results/demo-recordings/branch-review-slow-query-index",
    "branch-review:all": "node tools/forger.js branch-review --scenario slow-query-index --record bench/results/demo-recordings/branch-review-slow-query-index && node tools/forger.js branch-review --scenario pagination-scale --record bench/results/demo-recordings/branch-review-pagination-scale && node tools/forger.js branch-review --scenario storage-metadata --record bench/results/demo-recordings/branch-review-storage-metadata",
    "project-review:demo": "node tools/forger.js project-review --project optimizer/fixtures/agent_projects/insforge-customer-portal --out bench/results/demo-recordings/project-review-customer-portal",
    "frontier-plus": "node optimizer/eval/repair_submission.js --input bench/results/sub_fo-frontier.json --tag frontier-plus --model forge-optimizer:frontier-plus && node bench/bench/eval_submission.js bench/results/sub_fo-frontier-plus.json bench/results/score_fo-frontier-plus.json",
    "frontier-report:raw": "node optimizer/eval/frontier_report.js --score bench/results/score_fo-frontier-plus-raw.json --baseline bench/results/score_codex.json --out optimizer/results/frontier_run.json --model forge-optimizer-frontier:frontier-plus-raw --status live-run-raw",
    "frontier-report:plus": "node optimizer/eval/frontier_report.js --score bench/results/score_fo-frontier-plus-distill.json --baseline bench/results/score_codex.json --out optimizer/results/frontier_run.repair_assisted_live.json --model forge-optimizer-frontier:frontier-plus-distill-repair-verified --status live-run-repair",
    "frontier-audit:repair": "node optimizer/eval/audit_repair_layer.js",
    "agent-repair:bench": "node optimizer/eval/agent_repair_benchmark.js",
    "project-repair:bench": "node optimizer/eval/project_repair_benchmark.js",
    "proof:repair": "npm run agent-repair:bench && npm run project-repair:bench && npm run frontier-audit:repair",
    "frontier-gate:raw": "node optimizer/eval/frontier_gate.js --file optimizer/results/frontier_run.json",
    "frontier-validate": "node tools/forger.js frontier-validate --file optimizer/results/frontier_run.json",
    "frontier-validate:recorded": "node tools/forger.js frontier-validate --file optimizer/results/frontier_run.recorded.json",
    "modal:gpu-probe": "modal run -q tools/modal_gpu_probe.py --out optimizer/results/modal_probe.json",
    "modal:frontier": "modal run -q tools/modal_frontier.py::frontier --data-n 80 --steps 140 --epochs 1 --tag modal-weakfix-h100 --out-dir optimizer/results/modal-weakfix-h100",
    "modal:frontier-fast": "modal run -q tools/modal_frontier.py::frontier --data-n 80 --steps 48 --epochs 1 --num-generations 2 --max-completion 512 --grad-accum 2 --save-steps 12 --tag modal-weakfix-fast --out-dir optimizer/results/modal-weakfix-fast",
    "ci:judge": "npm run check && npm run branch-review:all && npm run project-review:demo && npm run proof:repair && npm run frontier-validate",
    "check": "cd bench && npm run check"
  },
  "license": "MIT"
}
